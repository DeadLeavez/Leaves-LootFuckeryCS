<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>LootFuckery</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.5.0</Version>
    <!-- Build straight into a droppable user/mods/<ModName> layout at the workspace root -->
    <OutputPath>..\dist\SPT\user\mods\$(MSBuildProjectName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" />
    <!-- SPTarkov.Reflection.Patching (AbstractPatch) - the Harmony wrapper used by RealRunCapture's
         postfix. Server.Core depends on it at runtime but doesn't expose it at compile time, so it needs
         its own reference. Like the other SPT packages, the SDK doesn't copy it into the mod output. -->
    <PackageReference Include="SPTarkov.Reflection" Version="4.0.11" />
    <!-- LeavesUtils ships as its own separately-installed mod - compile against it, but don't copy a dll -->
    <ProjectReference Include="../Leaves-LeavesUtil/Leaves-LeavesUtil.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="output\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The web-UI pages (dump viewer + run history) served by LootWebApi. Read fresh off disk on each
         request, so edits to the deployed files show up without a rebuild. -->
    <None Include="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyToSecondaryLocation" AfterTargets="Build">
    <ItemGroup>
      <OutputFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>

    <!-- 1. Purge the ENTIRE previous _dist (old-version zips included) so a version bump doesn't
         leave stale zips behind and removed/renamed files don't stick round -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist"
      Condition="Exists('$(MSBuildProjectDirectory)\_dist')" />

    <!-- 2. Copy fresh build output into the mod folder structure -->
    <Copy SourceFiles="@(OutputFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)\_dist\SPT\user\mods\$(MSBuildProjectName)\%(RecursiveDir)"
      SkipUnchangedFiles="true" />

    <!-- 3. Zip the CONTENTS of _dist -->
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\_dist"
      DestinationFile="$(MSBuildProjectDirectory)\$(MSBuildProjectName)_$(Version).zip"
      Overwrite="true" />

    <!-- 4. Purge the loose folder, leaving only the zip -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\_dist\SPT" />

    <!-- 5. Move the finished zip into _dist -->
    <Move SourceFiles="$(MSBuildProjectDirectory)\$(MSBuildProjectName)_$(Version).zip"
      DestinationFiles="$(MSBuildProjectDirectory)\_dist\$(MSBuildProjectName)_$(Version).zip" />
  </Target>
</Project>